{
  "scopeName": "source.sketchlibx",
  "name": "SketchLibX Universal",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#tags"},
    {"include": "#markdown"},
    {"include": "#numbers"},
    {"include": "#constants"},
    {"include": "#keywords"},
    {"include": "#operators"},
    {"include": "#function-call"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.sketchlibx", "match": "//.*$"},
        {"name": "comment.line.hash.sketchlibx", "match": "#(?!include|define|if|ifdef|ifndef|endif|pragma|region|endregion).*?$"},
        {"name": "comment.line.semicolon.sketchlibx", "match": ";;.*$"},
        {"name": "comment.block.sketchlibx", "begin": "/\\*", "end": "\\*/"},
        {"name": "comment.block.xml.sketchlibx", "begin": "<!--", "end": "-->"}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.quoted.double.sketchlibx", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.sketchlibx", "match": "\\\\."}]},
        {"name": "string.quoted.single.sketchlibx", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.sketchlibx", "match": "\\\\."}]},
        {"name": "string.quoted.triple.sketchlibx", "begin": "'''", "end": "'''"},
        {"name": "string.template.sketchlibx", "begin": "`", "end": "`", "patterns": [{"name": "constant.character.escape.sketchlibx", "match": "\\\\."}]}
      ]
    },
    "tags": {
      "patterns": [
        {"name": "entity.name.tag.sketchlibx", "match": "</?[A-Za-z_][A-Za-z0-9_.:-]*"},
        {"name": "entity.other.attribute-name.sketchlibx", "match": "\\b[A-Za-z_:][A-Za-z0-9_.:-]*(?=\\s*=)"},
        {"name": "punctuation.definition.tag.sketchlibx", "match": "[<>/]"}
      ]
    },
    "markdown": {
      "patterns": [
        {"name": "markup.heading.sketchlibx", "match": "^\\s{0,3}#{1,6}\\s+.*$"},
        {"name": "markup.list.sketchlibx", "match": "^\\s*[-*+]\\s+|^\\s*\\d+[.)]\\s+"},
        {"name": "markup.bold.sketchlibx", "match": "\\*\\*[^*]+\\*\\*|__[^_]+__"},
        {"name": "markup.italic.sketchlibx", "match": "(?<!\\w)[*_][^*_\\n]+[*_](?!\\w)"},
        {"name": "markup.inline.code.sketchlibx", "match": "`[^`\\n]+`"},
        {"name": "markup.quote.sketchlibx", "match": "^\\s*>.*$"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.hex.sketchlibx", "match": "\\b0[xX][0-9A-Fa-f]+\\b"},
        {"name": "constant.numeric.bin.sketchlibx", "match": "\\b0[bB][01]+\\b"},
        {"name": "constant.numeric.float.sketchlibx", "match": "\\b(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?[fFdD]?\\b"},
        {"name": "constant.numeric.integer.sketchlibx", "match": "\\b\\d+[lLuUfF]?\\b"}
      ]
    },
    "constants": {
      "patterns": [
        {"name": "constant.language.sketchlibx", "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|True|False|TRUE|FALSE|NULL)\\b"},
        {"name": "constant.other.sketchlibx", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.sketchlibx", "match": "\\b(?:if|else|elseif|elif|for|foreach|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|throws|when|match|yield|goto|await|async|defer)\\b"},
        {"name": "storage.type.sketchlibx", "match": "\\b(?:class|interface|struct|enum|object|record|trait|protocol|extension|namespace|package|import|include|using|module|fun|fn|function|def|var|let|val|const|final|static|public|private|protected|internal|abstract|override|virtual|inline|extern|volatile|synchronized|operator|template|typename|typedef|sizeof|typeof|instanceof|new|delete|this|super|self)\\b"},
        {"name": "storage.modifier.sketchlibx", "match": "\\b(?:int|long|short|byte|float|double|char|boolean|bool|void|String|string|Object|Any|Unit|dynamic|auto|unsigned|signed|size_t|uint|ulong|decimal)\\b"},
        {"name": "keyword.other.sketchlibx", "match": "\\b(?:SELECT|FROM|WHERE|INSERT|INTO|UPDATE|DELETE|CREATE|ALTER|DROP|JOIN|LEFT|RIGHT|INNER|OUTER|GROUP|ORDER|BY|HAVING|LIMIT|VALUES|AS|AND|OR|NOT|IN|IS|NULL|LIKE|DISTINCT)\\b"}
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.sketchlibx", "match": "(?:===|!==|==|!=|<=|>=|=>|->|::|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|<<|>>|>>>|\\?\\?|\\?\\.|[+*/%=<>!&|^~-])"}
      ]
    },
    "function-call": {
      "patterns": [
        {"name": "entity.name.function.sketchlibx", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"},
        {"name": "entity.name.type.class.sketchlibx", "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*(?:<[^>]+>)?\\s*[({])"}
      ]
    }
  }
}
